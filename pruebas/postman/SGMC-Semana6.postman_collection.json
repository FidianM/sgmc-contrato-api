      "name": "Registrar pago — POST /creditos/{creditoId}/pagos",
      "item": [
        {
          "name": "201 · Pago registrado (caso de referencia 6.6.3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "5b0b9e2e-6a1f-4a5c-9c1e-0d6d1a1f0b3a",
                "type": "text"
              },
              {
                "key": "Prefer",
                "value": "code=201",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/creditos/C-004/pagos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "creditos",
                "C-004",
                "pagos"
              ]
            },
            "description": "Caso exitoso. Usa el ejemplo pagoExacto del contrato (cuota 2 vencida, sección 6.6.3). Lleva Prefer: code=201 porque esta operación define DOS respuestas 2xx (200 y 201); sin esa cabecera, Prism responde por defecto con el código más bajo (200).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monto\": {\n    \"valor\": \"1011.88\",\n    \"moneda\": \"GTQ\"\n  },\n  \"fechaPago\": \"2026-08-22\",\n  \"medio\": \"agente_bancario\",\n  \"referencia\": \"BOL-88213\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('el desglose respeta el orden de prelación (sección 6.6)', function () {",
                  "    const c = pm.response.json();",
                  "    pm.expect(c.aplicacion).to.have.all.keys('gastos','interesMoratorio','interesCorriente','capital','excedente');",
                  "});",
                  "pm.test('reproducido es false en un pago nuevo', function () {",
                  "    pm.expect(pm.response.json().reproducido).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
