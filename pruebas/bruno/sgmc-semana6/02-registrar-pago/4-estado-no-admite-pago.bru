meta {
  name: 422 · El crédito no admite pagos en su estado actual
  type: http
  seq: 4
}

post {
  url: {{base_url}}/creditos/C-004/pagos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/problem+json
  Idempotency-Key: 5b0b9e2e-6a1f-4a5c-9c1e-0d6d1a1f0b3a
  Prefer: code=422
}

body:json {
  {
    "monto": { "valor": "1011.88", "moneda": "GTQ" },
    "fechaPago": "2026-08-22",
    "medio": "agente_bancario",
    "referencia": "BOL-88213"
  }
}

docs {
  Fuerza el escenario 422: el crédito está en un estado que no admite
  pagos (p. ej. 'solicitado').
}

tests {
  test("responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  test("el status del cuerpo coincide con el código HTTP", function () {
    expect(res.getBody().status).to.equal(422);
  });
}
